// Prisma schema for ЖК Landing Constructor
// Production: PostgreSQL (Neon). Connection string is in DATABASE_URL env var.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH ----------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("manager") // "admin" | "manager"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- PROJECTS (ЖК) ----------
model Project {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  status         String   @default("draft") // "draft" | "published"
  themePreset    String   @default("noir")
  fontPreset     String   @default("inter")

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?

  // GEO
  geoRegion      String?
  geoCity        String?
  geoLat         Float?
  geoLng         Float?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hero            HeroBlock?
  about           AboutSection?
  gallery         GalleryImage[]
  advantages      Advantage[]
  floorCategories FloorPlanCategory[]
  interiors       InteriorItem[]
  catalog         Catalog?
  socials         SocialLink[]
  leads           Lead[]
  leadForm        LeadFormConfig?
}

model HeroBlock {
  id            String  @id @default(cuid())
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  subtitle      String?
  ctaText       String  @default("Оставить заявку")
  desktopImage  String?
  mobileImage   String?
}

model Advantage {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String? // lucide icon name from curated list, OR "custom" to use customIconSvg
  customIconSvg String? // raw SVG markup when icon="custom"
  sortOrder   Int     @default(0)

  @@index([projectId])
}

model AboutSection {
  id            String         @id @default(cuid())
  projectId     String         @unique
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  mapEmbedUrl   String? // iframe src (Yandex/Google Maps)
  mapLat        Float?
  mapLng        Float?
  nearby        NearbyObject[]
}

model NearbyObject {
  id        String       @id @default(cuid())
  aboutId   String
  about     AboutSection @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  name      String
  distance  String // e.g. "5 мин пешком"
  sortOrder Int @default(0)

  @@index([aboutId])
}

model GalleryImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int     @default(0)

  @@index([projectId])
}

model FloorPlanCategory {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int              @default(0)
  units     FloorPlanUnit[]

  @@index([projectId])
}

model FloorPlanUnit {
  id         String             @id @default(cuid())
  categoryId String
  category   FloorPlanCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String?
  area       Float
  imageUrl   String?
  sortOrder  Int                @default(0)

  @@index([categoryId])
}

model InteriorItem {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl    String
  caption     String?
  description String?
  sortOrder   Int     @default(0)

  @@index([projectId])
}

model Catalog {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String?
}

model SocialLink {
  id        String   @id @default(cuid())
  projectId String?  // null = global (used as default for all projects)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  icon      String? // lucide icon name
  sortOrder Int      @default(0)
}

model Lead {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  comment   String?
  status    String   @default("new") // new | in_progress | done | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// Per-project lead form configuration.
// Two modes:
//   - "native": built-in form (name + phone + comment) → creates a Lead in DB
//   - "bitrix24": embeds Bitrix24 CRM form widget via <script> tag
//     Admin enters portal ID (e.g. b35129330) and form ID (e.g. 12), and
//     the widget is injected on the /zhk/[slug]#leads-form page.
model LeadFormConfig {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formType            String   @default("native") // "native" | "bitrix24"
  // Bitrix24 config (only used when formType = "bitrix24")
  bitrixPortalId      String?  // e.g. "b35129330" — appears in cdn-ru.bitrix24.kz/b35129330/crm/form/loader_XX.js
  bitrixFormId        String?  // e.g. "12" — loader_12.js + data-b24-form="inline/12/..."
  bitrixEmbedCode     String?  // optional: full <script>...</script> from Bitrix24 UI (overrides portal/form IDs)
  sectionTitle        String?  // optional heading above the form (defaults to "Оставьте заявку на просмотр")
  sectionSubtitle     String?  // optional subtitle text
  updatedAt           DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model PrivacyPolicy {
  id        String   @id @default("singleton")
  content   String
  updatedAt DateTime @updatedAt
}

// ---------- HOME PAGE (editable) ----------
model HomePage {
  id            String   @id @default("singleton")
  title         String
  subtitle      String?
  heroImage     String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- ADVANTAGE ICONS (curated + custom SVG) ----------
// Stored as raw SVG markup (string). Rendered via dangerouslySetInnerHTML.
model AdvantageIcon {
  id        String   @id @default(cuid())
  name      String   @unique
  svgMarkup String   // raw <svg>...</svg>
  createdAt DateTime @default(now())
}
